# bare repo files
/.cfg/

# mac only
.DS_Store

# machine-local shell and Git configuration
# Legacy locations remain ignored until every existing Mac is migrated.
/.gitconfig.local
/.zshrc.local
/.config/zsh/.zshrc.local
/.config/git/config.local
/.Brewfile.local
/.config/git/allowed_signers.local
/.config/tmux-sessionizer/tmux-sessionizer.local.conf

# machine-local credentials
/.ssh/
/.env
/.env.*
**/credentials.local
**/secrets.local

# Herdr runtime state
/.config/herdr/*.log
/.config/herdr/*.sock
/.config/herdr/session*.json
/.config/herdr/plugins.json
/.config/herdr/plugins/

# managed plugin directories and editor-local metadata
/.config/tmux/plugins/
/.config/nvim/.luarc.json
