#!/bin/bash

unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

script_dir=$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$script_dir/lib.sh"
# shellcheck source=local_migration.sh
source "$script_dir/local_migration.sh"

NVIM_TEMP_ROOT=
TMUX_TEMP_ROOT=
TMUX_SHORT_ROOT=
TMUX_EXECUTABLE=
TMUX_SOCKET_PATH=
TMUX_SERVER_STARTED=0

resolve_executable() {
  local resolved

  resolved=$(command -v "$1" 2>/dev/null) || return 1
  case $resolved in
    /*) [[ -x $resolved ]] || return 1 ;;
    *) return 1 ;;
  esac
  RESOLVED_EXECUTABLE=$resolved
}

cleanup_nvim_state() {
  if owned_temp_dir "$NVIM_TEMP_ROOT" dotfiles-check.nvim.; then
    /bin/rm -rf -- "$NVIM_TEMP_ROOT"
  fi
  NVIM_TEMP_ROOT=
}

owned_temp_dir() {
  local path=$1
  local prefix=$2
  local owner
  local current_user

  [[ -n $path && -d $path && ${path##*/} == "$prefix"* ]] || return 1
  owner=$(/usr/bin/stat -f '%u' "$path" 2>/dev/null) || return 1
  current_user=$(/usr/bin/id -u) || return 1
  [[ $owner == "$current_user" ]]
}

cleanup_tmux_state() {
  if [[ $TMUX_SERVER_STARTED -eq 1 && -n $TMUX_EXECUTABLE && -n $TMUX_SOCKET_PATH && -n $TMUX_TEMP_ROOT ]] && \
    owned_temp_dir "$TMUX_SHORT_ROOT" dc-tmux.; then
    /usr/bin/env -i \
      HOME="$TMUX_TEMP_ROOT/home" \
      XDG_CONFIG_HOME="$TMUX_TEMP_ROOT/config" \
      XDG_STATE_HOME="$TMUX_TEMP_ROOT/state" \
      XDG_CACHE_HOME="$TMUX_TEMP_ROOT/cache" \
      ZDOTDIR="$TMUX_TEMP_ROOT/home" \
      TMUX_TMPDIR="$TMUX_SHORT_ROOT" \
      SHELL=/bin/sh \
      PATH=/usr/bin:/bin \
      TERM=xterm-256color \
      "$TMUX_EXECUTABLE" -S "$TMUX_SOCKET_PATH" kill-server >/dev/null 2>&1 || true
  fi
  TMUX_SERVER_STARTED=0
  if owned_temp_dir "$TMUX_TEMP_ROOT" dotfiles-check.tmux.; then
    /bin/rm -rf -- "$TMUX_TEMP_ROOT"
  fi
  if [[ $TMUX_SHORT_ROOT == /tmp/dc-tmux.* ]] && owned_temp_dir "$TMUX_SHORT_ROOT" dc-tmux.; then
    /bin/rm -rf -- "$TMUX_SHORT_ROOT"
  fi
  TMUX_TEMP_ROOT=
  TMUX_SHORT_ROOT=
  TMUX_EXECUTABLE=
  TMUX_SOCKET_PATH=
}

cleanup_runtime_state() {
  cleanup_tmux_state
  cleanup_nvim_state
}

handle_signal() {
  local status=$1

  cleanup_runtime_state
  trap - EXIT
  exit "$status"
}

usage() {
  printf 'Usage: %s [--fetch | --help]\n' "${0##*/}"
}

sanitize_git_environment() {
  unset GIT_CONFIG GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
  unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
  export GIT_CONFIG_NOSYSTEM=1
  export GIT_OPTIONAL_LOCKS=0
}

canonical_directory() {
  (cd -P -- "$1" 2>/dev/null && pwd)
}

canonical_file() {
  local path=$1
  local directory

  directory=$(canonical_directory "$(/usr/bin/dirname -- "$path")") || return 1
  printf '%s/%s\n' "$directory" "$(/usr/bin/basename -- "$path")"
}

controlled_config() (
  local key=$1

  sanitize_git_environment
  HOME=$DOTFILES_WORK_TREE
  XDG_CONFIG_HOME=$DOTFILES_WORK_TREE/.config
  export HOME XDG_CONFIG_HOME
  /usr/bin/git config --global --includes --show-origin --get "$key" 2>/dev/null
)

read_local_config_value() {
  local key=$1
  local local_config=$2
  local setting
  local origin
  local expected_origin

  setting=$(controlled_config "$key") || return 1
  [[ $setting == *$'\t'* && $setting != *$'\n'* ]] || return 1
  origin=${setting%%$'\t'*}
  CONFIG_VALUE=${setting#*$'\t'}
  [[ $origin == file:* && -n $CONFIG_VALUE ]] || return 1
  origin=${origin#file:}
  origin=$(canonical_file "$origin") || return 1
  expected_origin=$(canonical_file "$local_config") || return 1
  [[ $origin == "$expected_origin" ]]
}

check_platform() {
  if [[ ${DOTFILES_SKIP_PLATFORM_CHECK:-0} == 1 ]]; then
    warn 'platform check skipped by explicit test override'
  elif [[ $(/usr/bin/uname -s 2>/dev/null) == Darwin && $(/usr/bin/uname -m 2>/dev/null) == arm64 ]]; then
    pass 'platform is Darwin arm64'
  else
    fail_check 'platform must be Darwin arm64'
  fi
}

check_repository() {
  local bare
  local actual_work_tree
  local expected_work_tree

  if [[ ! -d $DOTFILES_GIT_DIR ]]; then
    fail_check 'dotfiles Git directory is missing'
    return 1
  fi
  if [[ ! -d $DOTFILES_WORK_TREE ]]; then
    fail_check 'dotfiles work tree is missing'
    return 1
  fi

  bare=$(dotgit config --bool core.bare 2>/dev/null) || bare=
  if [[ $bare == true ]]; then
    pass 'dotfiles repository is bare'
  else
    fail_check 'dotfiles repository is not bare'
  fi

  actual_work_tree=$(dotgit rev-parse --show-toplevel 2>/dev/null) || actual_work_tree=
  actual_work_tree=$(canonical_directory "$actual_work_tree") || actual_work_tree=
  expected_work_tree=$(canonical_directory "$DOTFILES_WORK_TREE") || expected_work_tree=
  if [[ -n $actual_work_tree && $actual_work_tree == "$expected_work_tree" ]]; then
    pass 'dotfiles work tree is explicit and expected'
  else
    fail_check 'dotfiles work tree does not match the explicit path'
  fi
}

check_remote() {
  local fetch_requested=$1
  local origin_url
  local refspec
  local branch
  local upstream_remote
  local upstream_merge
  local upstream
  local counts
  local ahead
  local behind

  origin_url=$(dotgit config --get remote.origin.url 2>/dev/null) || origin_url=
  if [[ -n $origin_url ]]; then
    pass 'origin URL is configured'
  else
    fail_check 'origin URL is missing'
  fi

  refspec=$(dotgit config --get-all remote.origin.fetch 2>/dev/null) || refspec=
  if [[ $refspec == '+refs/heads/*:refs/remotes/origin/*' ]]; then
    pass 'origin fetch refspec is exact'
  else
    fail_check 'origin fetch refspec is missing or unexpected'
  fi

  branch=$(dotgit symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=
  upstream_remote=$(dotgit config --get "branch.$branch.remote" 2>/dev/null) || upstream_remote=
  upstream_merge=$(dotgit config --get "branch.$branch.merge" 2>/dev/null) || upstream_merge=
  if [[ -n $branch && -n $upstream_remote && -n $upstream_merge ]]; then
    pass 'upstream is configured'
  else
    fail_check 'upstream is missing'
  fi

  if [[ $fetch_requested == 1 ]]; then
    if dotgit fetch --prune origin; then
      pass 'origin refs fetched with pruning'
    else
      fail_check 'origin fetch failed'
    fi
  fi

  upstream=$(dotgit rev-parse --verify --quiet '@{upstream}^{commit}' 2>/dev/null) || upstream=
  if [[ -n $upstream ]]; then
    counts=$(dotgit rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null) || counts=
    if [[ $counts == *$'\t'* ]]; then
      ahead=${counts%%$'\t'*}
      behind=${counts#*$'\t'}
      pass "branch relation: ahead $ahead, behind $behind"
    else
      fail_check 'could not determine ahead and behind counts'
    fi
  elif [[ -n $branch && -n $upstream_remote && -n $upstream_merge ]]; then
    fail_check 'configured upstream ref is unavailable'
  fi
}

check_tracked_status() {
  if dotgit diff --quiet -- 2>/dev/null; then
    pass 'tracked work-tree files are unchanged'
  else
    fail_check 'tracked work-tree files have changes'
  fi

  if dotgit diff --cached --quiet -- 2>/dev/null; then
    pass 'index has no staged changes'
  else
    fail_check 'index has staged changes'
  fi
}

check_legacy_local_migrations() {
  if report_legacy_local_migrations "$DOTFILES_WORK_TREE"; then
    pass 'legacy machine-local configuration paths are absent'
  else
    fail_check 'legacy machine-local configuration requires manual migration'
  fi
}

check_identity_and_signing() {
  local local_config=$DOTFILES_WORK_TREE/.config/git/config.local
  local name
  local email
  local signing_key
  local allowed_signers
  local public_key_line
  local public_key_type
  local public_key_data

  if [[ ! -f $local_config ]]; then
    fail_check 'machine-local Git identity file is missing'
    return
  fi

  if read_local_config_value user.name "$local_config"; then
    name=$CONFIG_VALUE
  else
    name=
  fi
  if read_local_config_value user.email "$local_config"; then
    email=$CONFIG_VALUE
  else
    email=
  fi
  if read_local_config_value user.signingKey "$local_config"; then
    signing_key=$CONFIG_VALUE
  else
    signing_key=
  fi
  if read_local_config_value gpg.ssh.allowedSignersFile "$local_config"; then
    allowed_signers=$CONFIG_VALUE
  else
    allowed_signers=
  fi

  if [[ -n $name && -n $email && -n $signing_key ]]; then
    pass 'effective Git identity is complete and machine-local'
  else
    fail_check 'effective machine-local Git identity is incomplete'
  fi

  if [[ -z $allowed_signers ]]; then
    fail_check 'effective allowed signers file is missing from local config'
    return
  fi

  signing_key=$(HOME=$DOTFILES_WORK_TREE expand_home_path "$signing_key")
  allowed_signers=$(HOME=$DOTFILES_WORK_TREE expand_home_path "$allowed_signers")

  if [[ ! -f $signing_key ]]; then
    fail_check 'configured public signing key file is missing'
    return
  fi
  pass 'configured public signing key file exists'

  if [[ ! -f $allowed_signers ]]; then
    fail_check 'configured allowed signers file is missing'
    return
  fi
  pass 'configured allowed signers file exists'

  public_key_line=$(/usr/bin/awk 'NF >= 2 && $1 !~ /^#/ { print $1 "\t" $2; exit }' "$signing_key" 2>/dev/null) || public_key_line=
  public_key_type=${public_key_line%%$'\t'*}
  public_key_data=${public_key_line#*$'\t'}
  if [[ -z $email || -z $public_key_type || -z $public_key_data || $public_key_line != *$'\t'* ]]; then
    fail_check 'public signing key is malformed'
  elif /usr/bin/awk -v expected_email="$email" -v expected_type="$public_key_type" -v expected_key="$public_key_data" '
    function supported_key_type(value) {
      return value ~ /^(ssh-(rsa|dss|ed25519)(-cert-v01@openssh.com)?|ecdsa-sha2-[[:alnum:]-]+(-cert-v01@openssh.com)?|sk-ssh-ed25519(@openssh.com|-cert-v01@openssh.com)|sk-ecdsa-sha2-[[:alnum:]-]+(@openssh.com|-cert-v01@openssh.com))$/
    }
    /^[[:space:]]*#/ || NF == 0 { next }
    {
      principal_count = split($1, principals, ",")
      principal_match = 0
      for (principal_index = 1; principal_index <= principal_count; principal_index++) {
        if (principals[principal_index] == expected_email) principal_match = 1
      }
      for (field = 2; field < NF; field++) {
        if (supported_key_type($field)) {
          if (principal_match && $field == expected_type && $(field + 1) == expected_key) {
            found = 1
            exit
          }
          next
        }
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$allowed_signers" >/dev/null 2>&1; then
    pass 'allowed signer matches the effective identity and public key'
  else
    fail_check 'allowed signer does not match the effective identity and public key'
  fi

  if dotgit -c gpg.format=ssh -c "gpg.ssh.allowedSignersFile=$allowed_signers" verify-commit HEAD >/dev/null 2>&1; then
    pass 'HEAD commit signature is valid'
  else
    fail_check 'HEAD commit signature verification failed'
  fi
}

check_syntax() {
  local tracked_files
  local old_ifs
  local path
  local first_line
  local bash_entrypoint
  local zsh_entrypoint
  local zsh_found=0
  local zsh_ok=1
  local bash_found=0
  local bash_ok=1

  tracked_files=$(dotgit ls-files 2>/dev/null) || {
    fail_check 'could not list tracked files for syntax checks'
    return
  }

  old_ifs=$IFS
  IFS=$'\n'
  for path in $tracked_files; do
    first_line=
    if [[ -f $DOTFILES_WORK_TREE/$path ]]; then
      IFS= read -r first_line < "$DOTFILES_WORK_TREE/$path" || true
    fi
    bash_entrypoint=0
    zsh_entrypoint=0
    case $first_line in
      '#!'*'/bash'*|'#!'*'env bash'*|'#!'*'/sh'|'#!'*'env sh'*) bash_entrypoint=1 ;;
      '#!'*'/zsh'*|'#!'*'env zsh'*) zsh_entrypoint=1 ;;
    esac
    case $path in
      *.zsh|.zshenv|.zprofile|.zshrc|*/.zprofile|*/.zshrc)
        zsh_entrypoint=1
        ;;
    esac
    if [[ $zsh_entrypoint -eq 1 ]]; then
      zsh_found=1
      if [[ ! -x /bin/zsh ]] || ! /bin/zsh -n "$DOTFILES_WORK_TREE/$path" >/dev/null 2>&1; then
        zsh_ok=0
      fi
    fi
    case $path in
      *.sh) bash_entrypoint=1 ;;
    esac
    if [[ $bash_entrypoint -eq 1 ]]; then
      bash_found=1
      if [[ ! -x /bin/bash ]] || ! /bin/bash -n "$DOTFILES_WORK_TREE/$path" >/dev/null 2>&1; then
        bash_ok=0
      fi
    fi
  done
  IFS=$old_ifs

  if [[ $zsh_found -eq 0 ]]; then
    warn 'no tracked Zsh files found for syntax checking'
  elif [[ $zsh_ok -eq 1 ]]; then
    pass 'tracked Zsh files pass syntax checks'
  else
    fail_check 'a tracked Zsh file failed syntax checking'
  fi

  if [[ $bash_found -eq 0 ]]; then
    warn 'no tracked dotfiles Bash scripts found for syntax checking'
  elif [[ $bash_ok -eq 1 ]]; then
    pass 'tracked dotfiles Bash scripts pass syntax checks'
  else
    fail_check 'a tracked dotfiles Bash script failed syntax checking'
  fi
}

check_nvim() {
  local nvim_executable
  local config_dir=$DOTFILES_WORK_TREE/.config/nvim
  local diagnostics
  local nvim_status=0

  if ! resolve_executable nvim; then
    warn 'nvim is unavailable; skipped headless startup check'
    return
  fi
  nvim_executable=$RESOLVED_EXECUTABLE
  if [[ ! -f $config_dir/init.lua ]]; then
    warn 'nvim config is unavailable; skipped headless startup check'
    return
  fi

  NVIM_TEMP_ROOT=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/dotfiles-check.nvim.XXXXXXXX") || {
    fail_check 'could not create isolated nvim state directory'
    return
  }
  /bin/mkdir -p "$NVIM_TEMP_ROOT/home" "$NVIM_TEMP_ROOT/config" "$NVIM_TEMP_ROOT/cache" \
    "$NVIM_TEMP_ROOT/data" "$NVIM_TEMP_ROOT/state"
  /bin/cp -R -- "$config_dir" "$NVIM_TEMP_ROOT/config/nvim"
  /bin/mkdir -p "$NVIM_TEMP_ROOT/data/nvim/lazy/lazy.nvim/lua/lazy"
  printf '%s\n' \
    'local M = {}' \
    'function M.setup(_) end' \
    'return M' > "$NVIM_TEMP_ROOT/data/nvim/lazy/lazy.nvim/lua/lazy/init.lua"
  diagnostics=$NVIM_TEMP_ROOT/diagnostics
  (
    ulimit -f 128
    /usr/bin/env -i \
      HOME="$NVIM_TEMP_ROOT/home" \
      XDG_CONFIG_HOME="$NVIM_TEMP_ROOT/config" \
      XDG_CACHE_HOME="$NVIM_TEMP_ROOT/cache" \
      XDG_DATA_HOME="$NVIM_TEMP_ROOT/data" \
      XDG_STATE_HOME="$NVIM_TEMP_ROOT/state" \
      PATH=/usr/bin:/bin \
      TERM=xterm-256color \
      "$nvim_executable" -i NONE --headless \
        -c 'lua if vim.v.errmsg ~= "" then vim.cmd("cquit 1") end' \
        -c 'qa!'
  ) > "$diagnostics" 2>&1 || nvim_status=$?
  if [[ $nvim_status -eq 0 ]] && \
    ! /usr/bin/grep -E 'Error detected while processing|(^|[^[:alnum:]_])E[0-9]+:|stack traceback:' \
      "$diagnostics" >/dev/null 2>&1; then
    pass 'nvim starts headlessly with isolated state'
  else
    fail_check 'nvim headless startup failed'
  fi
  cleanup_nvim_state
}

check_tmux() {
  local tmux_executable
  local session_name="dotfiles-check-$$"
  local config_file=$DOTFILES_WORK_TREE/.config/tmux/tmux.conf
  local diagnostics
  local tmux_status=0

  if ! resolve_executable tmux; then
    warn 'tmux is unavailable; skipped isolated startup check'
    return
  fi
  tmux_executable=$RESOLVED_EXECUTABLE
  if [[ ! -f $config_file ]]; then
    warn 'tmux config is unavailable; skipped isolated startup check'
    return
  fi

  TMUX_TEMP_ROOT=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/dotfiles-check.tmux.XXXXXXXX") || {
    fail_check 'could not create isolated tmux state directory'
    return
  }
  TMUX_SHORT_ROOT=$(/usr/bin/mktemp -d /tmp/dc-tmux.XXXXXXXX) || {
    fail_check 'could not create short tmux socket directory'
    cleanup_tmux_state
    return
  }
  if [[ $TMUX_SHORT_ROOT != /tmp/dc-tmux.* ]] || ! owned_temp_dir "$TMUX_SHORT_ROOT" dc-tmux.; then
    fail_check 'short tmux socket directory is outside the guarded scope'
    cleanup_tmux_state
    return
  fi
  TMUX_SOCKET_PATH=$TMUX_SHORT_ROOT/s
  if [[ ${#TMUX_SOCKET_PATH} -ge 100 ]]; then
    fail_check 'short tmux socket path exceeds the safe length'
    cleanup_tmux_state
    return
  fi
  TMUX_EXECUTABLE=$tmux_executable
  /bin/mkdir -p "$TMUX_TEMP_ROOT/home" "$TMUX_TEMP_ROOT/config" "$TMUX_TEMP_ROOT/state" \
    "$TMUX_TEMP_ROOT/cache"
  diagnostics=$TMUX_TEMP_ROOT/diagnostics
  (
    ulimit -f 128
    /usr/bin/env -i \
      HOME="$TMUX_TEMP_ROOT/home" \
      XDG_CONFIG_HOME="$TMUX_TEMP_ROOT/config" \
      XDG_STATE_HOME="$TMUX_TEMP_ROOT/state" \
      XDG_CACHE_HOME="$TMUX_TEMP_ROOT/cache" \
      ZDOTDIR="$TMUX_TEMP_ROOT/home" \
      TMUX_TMPDIR="$TMUX_SHORT_ROOT" \
      SHELL=/bin/sh \
      PATH=/usr/bin:/bin \
      TERM=xterm-256color \
      "$tmux_executable" -S "$TMUX_SOCKET_PATH" -f /dev/null new-session -d -s "$session_name"
  ) > "$diagnostics" 2>&1 || tmux_status=$?
  if [[ $tmux_status -eq 0 ]]; then
    TMUX_SERVER_STARTED=1
    tmux_status=0
    (
      ulimit -f 128
      /usr/bin/env -i \
        HOME="$TMUX_TEMP_ROOT/home" \
        XDG_CONFIG_HOME="$TMUX_TEMP_ROOT/config" \
        XDG_STATE_HOME="$TMUX_TEMP_ROOT/state" \
        XDG_CACHE_HOME="$TMUX_TEMP_ROOT/cache" \
        ZDOTDIR="$TMUX_TEMP_ROOT/home" \
        TMUX_TMPDIR="$TMUX_SHORT_ROOT" \
        SHELL=/bin/sh \
        PATH=/usr/bin:/bin \
        TERM=xterm-256color \
        "$tmux_executable" -S "$TMUX_SOCKET_PATH" source-file "$config_file"
    ) > "$diagnostics" 2>&1 || tmux_status=$?
  fi
  if [[ $TMUX_SERVER_STARTED -eq 1 && $tmux_status -eq 0 ]]; then
    pass 'tmux loads tracked config on an isolated socket'
  elif [[ $TMUX_SERVER_STARTED -eq 1 ]]; then
    fail_check 'tmux tracked config failed to load'
  else
    fail_check 'tmux isolated startup failed'
  fi
  cleanup_tmux_state
}

check_gitleaks() {
  local gitleaks_executable

  if ! resolve_executable gitleaks; then
    warn 'gitleaks is unavailable; skipped secret scan'
    return
  fi
  gitleaks_executable=$RESOLVED_EXECUTABLE
  if PATH=/usr/bin:/bin "$gitleaks_executable" git --no-banner --redact=100 --log-level warn "$DOTFILES_GIT_DIR"; then
    pass 'gitleaks found no secrets'
  else
    fail_check 'gitleaks reported findings or could not complete'
  fi
}

check_brewfile_dependencies() {
  local brewfile=$1
  local description=$2
  local brew_executable=$3
  local brew_path=$4

  if PATH="$brew_path" HOMEBREW_NO_AUTO_UPDATE=1 "$brew_executable" bundle check --file="$brewfile" >/dev/null 2>&1; then
    pass "$description dependencies are satisfied"
  else
    warn "$description dependencies are not fully satisfied"
  fi
}

check_brewfile() {
  local common_brewfile=
  local local_brewfile=$DOTFILES_WORK_TREE/.Brewfile.local
  local brew_executable
  local brew_path

  if [[ -f $DOTFILES_WORK_TREE/Brewfile ]]; then
    common_brewfile=$DOTFILES_WORK_TREE/Brewfile
  elif [[ -f $DOTFILES_WORK_TREE/.Brewfile ]]; then
    common_brewfile=$DOTFILES_WORK_TREE/.Brewfile
  fi

  if ! resolve_executable brew; then
    warn 'brew is unavailable; skipped Brewfile dependency check'
    return
  fi
  brew_executable=$RESOLVED_EXECUTABLE
  brew_path=${brew_executable%/*}:/usr/bin:/bin
  if [[ -z $common_brewfile ]]; then
    warn 'Brewfile is unavailable; skipped dependency check'
  else
    check_brewfile_dependencies "$common_brewfile" 'Brewfile' "$brew_executable" "$brew_path"
  fi
  if [[ -f $local_brewfile ]]; then
    check_brewfile_dependencies "$local_brewfile" 'local Brewfile' "$brew_executable" "$brew_path"
  fi
}

main() {
  local fetch_requested=0

  if [[ $# -gt 1 ]]; then
    usage >&2
    return 2
  fi
  if [[ $# -eq 1 ]]; then
    case $1 in
      --fetch) fetch_requested=1 ;;
      --help)
        usage
        return 0
        ;;
      *)
        usage >&2
        return 2
        ;;
    esac
  fi

  DOTFILES_GIT_DIR=${DOTFILES_GIT_DIR:-$HOME/.cfg}
  DOTFILES_WORK_TREE=${DOTFILES_WORK_TREE:-$HOME}
  export DOTFILES_GIT_DIR DOTFILES_WORK_TREE
  sanitize_git_environment
  trap cleanup_runtime_state EXIT
  trap 'handle_signal 130' INT
  trap 'handle_signal 143' TERM

  check_platform
  if check_repository; then
    check_remote "$fetch_requested"
    check_tracked_status
    check_legacy_local_migrations
    check_identity_and_signing
    check_syntax
    check_nvim
    check_tmux
    check_gitleaks
    check_brewfile
  fi
  summary
}

main "$@"
